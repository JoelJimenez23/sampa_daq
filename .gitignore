# Build output. Intermediate objects and the PC-only binary; both are
# regenerated with 'make'.
build/
bin/sampa_cfg_pc

__pycache__/
*.pyc

# NOTE: bin/sampa_cfg and bin/daqstat ARE committed on purpose. The board has
# no compiler, so they can be copied straight out of the repository.

# Data captures. A .bin from one run is megabytes and is not code; keep them
# elsewhere. See docs/CSV.md, section "Always keep the .bin".
*.bin
*_packets.csv
*_samples.csv
*_clusters.csv

# Pages generated by sampa_view
*.html
